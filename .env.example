# Supabase — from Project Settings → API in your Supabase dashboard.
# The site builds and runs without these; the admin panel and website booking
# requests stay switched off until they are set, and the public tariff falls
# back to the values in app/lib/rates-fallback.ts.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses row level security, so it must never be exposed to the
# browser or committed. Used to accept booking requests from the public site,
# to create staff accounts, and to track failed sign-ins for lockout.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where this deployment answers. Leave unset in production, where it defaults
# to https://www.hotelsamciriviera.com. A staging deployment must set it to its
# own address, or the links emailed to guests and staff — the feedback link and
# the "open the booking" link — will point at the live site instead of this one.
# Setting it to anything other than the live domain also tells search engines
# not to index the deployment.
NEXT_PUBLIC_SITE_URL=

# Lets the guest portal offer a password as well as an emailed one-time code.
# A testing affordance, not a feature: a staging deployment can usually only
# email one address, which would otherwise leave the rest of the team unable to
# open /account at all. A password proves nothing about an address, so a
# password account never inherits a guest profile that already exists — it
# starts empty. Leave this unset in production.
GUEST_PASSWORD_LOGIN=

# ── Optional integrations ─────────────────────────────────────────────────
# Without these the panel still works; each attempt is logged as "skipped".

# Every guest message and staff alert (Module 16): confirmations, pre-arrival
# reminders, check-in instructions, post-stay thank-yous, payment receipts,
# express check-out bills, and the alerts to staff. Without these, each attempt
# is still written to the notification log as "not configured", so nothing is
# lost silently — but nobody receives anything.
#
# Note this is NOT what sends the guest-portal sign-in code: that is Supabase
# Auth's own email, configured in the Supabase dashboard under Authentication.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL="Hotel Shamiyana <onboarding@resend.dev>"
# When you go live, verify hotelshamiyana.com in Resend (Domains → Add, then add the DNS records) and switch to reservations@hotelshamiyana.com add it in Resend → Domains → add the DNS records at your registrar → verify → then switch from to your real address.
# NOTIFY_FROM_EMAIL="Hotel Shamiyana <reservations@hotelshamiyana.com>"

# SMS, through Twilio. The same messages as above where the guest gave a
# number. WhatsApp is out of scope: the SOW marks it optional.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Razorpay — online payments (Module 7). From the Razorpay dashboard under
# Settings -> API Keys. Guests pay on Razorpay's own page through a payment
# link, so no card details ever reach this application.
# Leave blank to keep the panel on desk-recorded payments only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Signs the Razorpay webhook. Set the same value in the Razorpay dashboard
# under Settings -> Webhooks for https://<your-site>/api/payments/razorpay/webhook
# subscribed to payment_link.paid, payment_link.cancelled, payment_link.expired.
# Without it the webhook returns 503 and no online payment ever reaches a folio.
RAZORPAY_WEBHOOK_SECRET=

# Door lock middleware: receives {action, roomNumber, validFrom, validUntil, cards, ...}.
DOOR_LOCK_WEBHOOK_URL=
DOOR_LOCK_API_KEY=

# Two-factor sign-in. "demo" (default): the code is always DEMO_2FA_CODE — for
# demonstrations only, it protects nothing. "totp": real authenticator apps via
# Supabase MFA. Switch to totp before real guest data is entered.
TWO_FACTOR_MODE=demo
DEMO_2FA_CODE=123456

# In-room controls (Do Not Disturb). The controller posts to /api/room-controls
# with "Authorization: Bearer <this secret>". Leave blank to disable.
ROOM_CONTROLS_SECRET=

# Scheduled jobs, all guarded by this one secret and all disabled without it.
# Vercel Cron sends the header automatically when CRON_SECRET is set; see
# vercel.json for the schedules.
#   GET /api/cron/maintenance    escalates overdue tickets, raises preventive work
#   GET /api/cron/reports        emails the scheduled reports set up under Reports
#   GET /api/cron/notifications  pre-arrival reminders, check-in instructions,
#                                post-stay thank-yous, VIP arrival alerts
CRON_SECRET=

# Biometric attendance devices post to /api/attendance with
# "Authorization: Bearer <this secret>". Leave blank to disable.
ATTENDANCE_API_SECRET=

# Kitchen display for restaurant order tickets. The POS posts each ticket to
# this endpoint; with no URL set, tickets are printed from the browser instead.
# POS hardware is out of scope per the SOW, so this is integration only.
KOT_WEBHOOK_URL=
KOT_API_KEY=
